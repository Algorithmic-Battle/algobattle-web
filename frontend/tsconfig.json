{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "typescript_client/**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@client": ["./typescript_client"],
      "@client/*": ["./typescript_client/*"]
    }
  }
}
